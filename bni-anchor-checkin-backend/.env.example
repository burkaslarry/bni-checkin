# Copy to .env and fill in values.
# Never commit .env files with real credentials.
# - Local testing: use run.sh (do NOT set SPRING_PROFILES_ACTIVE; optional: LOCAL_DB_USER, LOCAL_DB_PASSWORD).
# - Production: use run_prod.sh (sets profile=render; set DATABASE_* below).

# Production only (run_prod.sh): set these when using run_prod.sh.
# SPRING_PROFILES_ACTIVE=render
# DATABASE_JDBC_URL=jdbc:postgresql://YOUR_HOST:5432/YOUR_DB?connectTimeout=5&socketTimeout=10
# DATABASE_USERNAME=your_db_user
# DATABASE_PASSWORD=your_db_password

# Supabase profile alternative
# SUPABASE_DATABASE_JDBC_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?connectTimeout=3&socketTimeout=5
# SUPABASE_DATABASE_USERNAME=postgres
# SUPABASE_DATABASE_PASSWORD=your_supabase_db_password

# Local testing only (run.sh): optional overrides for application.properties
# LOCAL_DATABASE_JDBC_URL=jdbc:postgresql://localhost:5432/bni_checkin
# LOCAL_DB_USER=your_local_pg_user
# LOCAL_DB_PASSWORD=your_local_pg_password

# Optional: DeepSeek API for guest/member matching
DEEPSEEK_API_KEY=

# Resend — email attendance CSV after event end (required for cron + admin test send)
# Create key at https://resend.com — never commit real keys
RESEND_API_KEY=
# ATTENDANCE_EMAIL_FROM=EventXP <info@innovatexp.co>
# ATTENDANCE_EMAIL_TO=lo.wailun5@gmail.com
# ATTENDANCE_EMAIL_ENABLED=true
# ATTENDANCE_EMAIL_POLL_MS=300000
# ATTENDANCE_EMAIL_GRACE_MINUTES=5

# Optional: Render sets PORT automatically for web services
# PORT=10000
