# BNI Anchor Check-in System - Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env files with real credentials.

# Local backend defaults
LOCAL_DATABASE_JDBC_URL=jdbc:postgresql://localhost:5432/bni_checkin
LOCAL_DB_USER=your_local_pg_user
LOCAL_DB_PASSWORD=your_local_pg_password

# Backend AI integration
DEEPSEEK_API_KEY=your_deepseek_api_key

# Render profile
DATABASE_JDBC_URL=jdbc:postgresql://your-render-host:5432/your_db?connectTimeout=5&socketTimeout=10
DATABASE_USERNAME=your_render_db_user
DATABASE_PASSWORD=your_render_db_password

# Supabase profile
SUPABASE_DATABASE_JDBC_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?connectTimeout=3&socketTimeout=5
SUPABASE_DATABASE_USERNAME=postgres
SUPABASE_DATABASE_PASSWORD=your_supabase_db_password

# Frontend
VITE_API_BASE=http://localhost:10000
