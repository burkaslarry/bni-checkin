# Frontend — never put AI or DB secrets in VITE_* (they ship in the public JS bundle).
# DeepSeek runs on the Render backend via DEEPSEEK_API_KEY, not here.

# Use localhost for local dev; production Vercel must point at the Render backend.
VITE_API_BASE=http://localhost:10000

# Root website URL for QR codes (always points to production check-in site)
# Optional - defaults to https://bni-anchor-checkin.vercel.app
# VITE_PUBLIC_URL=https://bni-anchor-checkin.vercel.app
