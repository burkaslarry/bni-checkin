# BNI Anchor Check-in System - Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env files with real credentials.

# Local backend defaults (default Spring profile: none — see application.properties)
LOCAL_DATABASE_JDBC_URL=jdbc:postgresql://localhost:5432/bni_checkin
LOCAL_DB_USER=your_local_pg_user
LOCAL_DB_PASSWORD=your_local_pg_password

# --- Run localhost API against REMOTE Postgres (pick ONE style) ---
# A) scripts/run_local_with_remote_db.sh with REMOTE_DB_PROFILE=render (or omit; default render):
DATABASE_JDBC_URL=jdbc:postgresql://your-render-host:5432/your_db?sslmode=require&connectTimeout=10
DATABASE_USERNAME=your_render_db_user
DATABASE_PASSWORD=your_render_db_password
#
# B) Same script with REMOTE_DB_PROFILE=properties — uses LOCAL_* as in application.properties:
# REMOTE_DB_PROFILE=properties
# LOCAL_DATABASE_JDBC_URL=jdbc:postgresql://REMOTE:5432/db?sslmode=require
# LOCAL_DB_USER=...
# LOCAL_DB_PASSWORD=...
#
# C) Or ./run.sh after setting LOCAL_DATABASE_JDBC_URL / LOCAL_DB_USER / LOCAL_DB_PASSWORD to the remote URL.

# Frontend — never put AI or DB secrets in VITE_* (they ship in the public JS bundle)
VITE_API_BASE=http://localhost:10000

# Render / local backend
CAPTCHA_SECRET=generate-a-long-random-string
DEEPSEEK_API_KEY=your_deepseek_api_key

# Render profile
DATABASE_JDBC_URL=jdbc:postgresql://your-render-host:5432/your_db?connectTimeout=5&socketTimeout=10
DATABASE_USERNAME=your_render_db_user
DATABASE_PASSWORD=your_render_db_password

# Supabase profile
SUPABASE_DATABASE_JDBC_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?connectTimeout=3&socketTimeout=5
SUPABASE_DATABASE_USERNAME=postgres
SUPABASE_DATABASE_PASSWORD=your_supabase_db_password
